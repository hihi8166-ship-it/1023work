  }


  /* .greet-button 은 greet 3.0(greetClass) 버튼만 붙인다. 3.5(new-components) 버튼은
     클래스 없이 data-variant 만 붙으므로 button 셀렉터를 함께 둔다. */
  .greet-button[data-variant="primary"],
  button[data-variant="primary"] {
    color: white;
